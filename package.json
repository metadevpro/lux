{
  "name": "lux-demo",
  "description": "Lux Library and documentation. User Interface components for Angular.",
  "license": "MIT",
  "version": "22.1.2",
  "author": {
    "name": "Metadev S.L.",
    "url": "https://metadev.pro"
  },
  "repository": {
    "type": "git",
    "url": "git@github.com:metadevpro/lux.git"
  },
  "bugs": {
    "url": "https://github.com/metadevpro/lux/issues"
  },
  "homepage": "https://github.com/metadevpro/lux",
  "keywords": [
    "lux",
    "metadev",
    "components",
    "user-interface",
    "angular",
    "typescript"
  ],
  "scripts": {
    "format:check": "prettier --check .",
    "format": "prettier --write .",
    "compodoc": "npx compodoc -p projects/lux/tsconfig.lib.json",
    "ng": "ng",
    "start": "ng serve",
    "build-start": "npm run build:lux && ng serve",
    "build": "ng build --configuration production",
    "build:lux": "ng build lux --configuration production",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage lux",
    "lint": "ng lint",
    "lint:lux": "ng lint lux",
    "publish-doc": "cd scripts && ./publish-lux-doc-s3.sh",
    "ci": "npm run format:check && npm run lint:lux && npm run test:coverage && ng build lux --configuration production",
    "npm-publish": "npm run ci && npm publish ./dist/lux --access public"
  },
  "private": true,
  "dependencies": {
    "@angular/common": "^22.2.3",
    "@angular/compiler": "22.2.3",
    "@angular/core": "22.2.3",
    "@angular/forms": "^22.2.3",
    "@angular/platform-browser": "^22.2.3",
    "@angular/router": "^22.2.3",
    "prismjs": "^1.30.0",
    "rxjs": "~7.8.2",
    "tslib": "^2.8.1",
    "zone.js": "^0.16.3"
  },
  "devDependencies": {
    "@angular/build": "22.2.5",
    "@angular/cli": "^22.2.5",
    "@angular/compiler-cli": "^22.2.3",
    "@angular/platform-browser-dynamic": "22.2.3",
    "@eslint/js": "^10.0.1",
    "@ngneat/spectator": "^22.1.0",
    "@types/jest": "^30.0.0",
    "@types/node": "^26.6.5",
    "angular-eslint": "^22.6.0",
    "eslint": "^10.13.0",
    "jest": "^30.5.2",
    "jest-environment-jsdom": "^30.5.2",
    "jest-preset-angular": "^17.0.3",
    "ng-packagr": "^22.2.5",
    "prettier": "^3.9.10",
    "ts-jest": "^29.4.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.1"
  },
  "allowScripts": {
    "@parcel/watcher@2.6.0": true,
    "msgpackr-extract@3.0.4": true,
    "unrs-resolver@1.12.2": true,
    "lmdb@3.5.6": true,
    "esbuild@0.28.2": true
  }
}
