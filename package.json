{
  "name": "lux-demo",
  "description": "Lux Library and documentation. User Interface components for Angular.",
  "license": "MIT",
  "version": "0.32.0",
  "author": {
    "name": "Metadev S.L.",
    "url": "https://metadev.pro"
  },
  "repository": {
    "type": "git",
    "url": "git@github.com:metadevpro/lux.git"
  },
  "bugs": {
    "url": "https://github.com/metadevpro/lux/issues"
  },
  "homepage": "https://github.com/metadevpro/lux",
  "keywords": [
    "lux",
    "metadev",
    "components",
    "user-interface",
    "angular",
    "typescript"
  ],
  "scripts": {
    "compodoc": "npx compodoc -p projects/lux/tsconfig.lib.json",
    "ng": "ng",
    "start": "ng serve",
    "start-heroku": "http-server -p $PORT dist/lux-demo/",
    "build-start": "npm run build:lux && ng serve",
    "build": "ng build --configuration production",
    "build:lux": "ng build lux --configuration production",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage lux",
    "test:coverage2": "echo Skip",
    "test:travis": "ng test lux --watch=false --code-coverage --browsers ChromeHeadlessCI",
    "tdd": "ng test lux",
    "lint": "ng lint",
    "lint:lux": "ng lint lux",
    "publish-doc": "cd scripts && ./publish-lux-doc-s3.sh",
    "ci": "npm run lint:lux && npm run test:coverage2 && ng build lux --configuration production",
    "npm-publish": "npm run lint:lux && npm run test:coverage2 && ng build lux --configuration production && npm publish ./dist/lux --access public"
  },
  "private": true,
  "dependencies": {
    "@angular/animations": "^20.3.16",
    "@angular/common": "^20.3.16",
    "@angular/compiler": "20.3.14",
    "@angular/core": "20.3.14",
    "@angular/forms": "^20.3.16",
    "@angular/platform-browser": "^20.3.16",
    "@angular/platform-browser-dynamic": "^20.3.16",
    "@angular/router": "^20.3.16",
    "prismjs": "^1.30.0",
    "rxjs": "~7.8.2",
    "tslib": "^2.8.1",
    "zone.js": "^0.15.0"
  },
  "devDependencies": {
    "@angular-builders/jest": "^12.0.0",
    "@angular-devkit/build-angular": "^21.1.0",
    "@angular-eslint/builder": "20.1.0",
    "@angular-eslint/eslint-plugin": "20.1.0",
    "@angular-eslint/eslint-plugin-template": "20.1.0",
    "@angular-eslint/schematics": "20.1.0",
    "@angular-eslint/template-parser": "20.1.0",
    "@angular/build": "20.3.12",
    "@angular/cli": "^21.1.0",
    "@angular/compiler-cli": "^20.3.12",
    "@angular/language-service": "^20.3.14",
    "@ngneat/spectator": "^19.4.2",
    "@types/jest": "^30.0.0",
    "@types/node": "^25.0.5",
    "@typescript-eslint/eslint-plugin": "8.53.0",
    "@typescript-eslint/parser": "8.53.0",
    "eslint": "^9.39.2",
    "eslint-plugin-import": "2.32.0",
    "eslint-plugin-jsdoc": "61.5.0",
    "http-server": "^14.1.1",
    "jest": "^25.5.4",
    "jest-preset-angular": "^16.0.0",
    "ng-packagr": "^20.0.1",
    "socket.io": ">=4.8.3",
    "ts-jest": "^25.5.1",
    "ts-node": "^1.7.1",
    "typescript": "5.9.3"
  }
