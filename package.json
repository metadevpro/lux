{
  "name": "lux-demo",
  "description": "Lux Library and documentation. User Interface components for Angular.",
  "license": "MIT",
  "version": "0.29.0",
  "author": {
    "name": "Metadev S.L.",
    "url": "https://metadev.pro"
  },
  "repository": {
    "type": "git",
    "url": "git@github.com:metadevpro/lux.git"
  },
  "bugs": {
    "url": "https://github.com/metadevpro/lux/issues"
  },
  "homepage": "https://github.com/metadevpro/lux",
  "keywords": [
    "lux",
    "metadev",
    "components",
    "user-interface",
    "angular",
    "typescript"
  ],
  "scripts": {
    "compodoc": "npx compodoc -p projects/lux/tsconfig.lib.json",
    "postinstall": "ng build lux --configuration production",
    "ng": "ng",
    "start": "ng serve",
    "start-heroku": "http-server -p $PORT dist/lux-demo/",
    "build-start": "npm run build:lux && ng serve",
    "build": "ng build --configuration production",
    "build:lux": "ng build lux --configuration production",
    "test": "ng test lux --watch=false",
    "test:coverage": "ng test lux --watch=false --code-coverage --browsers ChromeHeadlessCI",
    "test:travis": "ng test lux --watch=false --code-coverage --browsers ChromeHeadlessCI",
    "tdd": "ng test lux",
    "lint": "ng lint",
    "lint:lux": "ng lint lux",
    "publish-doc": "git push heroku devel:master",
    "npm-publish": "npm run lint:lux && npm run test:coverage && ng build lux --configuration production && npm publish ./dist/lux --access public"
  },
  "private": true,
  "dependencies": {
    "@angular/animations": "^18.0.2",
    "@angular/common": "^18.0.2",
    "@angular/compiler": "^18.0.2",
    "@angular/core": "^18.0.2",
    "@angular/forms": "^18.0.2",
    "@angular/platform-browser": "^18.0.2",
    "@angular/platform-browser-dynamic": "^18.0.2",
    "@angular/router": "^18.0.2",
    "http-server": "^14.1.1",
    "prismjs": "^1.29.0",
    "rxjs": "~7.8.1",
    "tslib": "^2.6.3",
    "zone.js": "^0.14.7"
  },
  "devDependencies": {
    "@angular-devkit/build-angular": "^18.0.3",
    "@angular-eslint/builder": "18.0.1",
    "@angular-eslint/eslint-plugin": "18.0.1",
    "@angular-eslint/eslint-plugin-template": "18.0.1",
    "@angular-eslint/schematics": "18.0.1",
    "@angular-eslint/template-parser": "18.0.1",
    "@angular/cli": "~18.0.3",
    "@angular/compiler-cli": "^18.0.2",
    "@angular/language-service": "^18.0.2",
    "@ngneat/spectator": "^18.0.2",
    "@types/jasmine": "~5.1.4",
    "@types/jasminewd2": "~2.0.13",
    "@types/node": "^20.14.2",
    "@typescript-eslint/eslint-plugin": "7.12.0",
    "@typescript-eslint/parser": "7.12.0",
    "eslint": "^8.57.0",
    "eslint-plugin-import": "2.29.1",
    "eslint-plugin-jsdoc": "48.2.9",
    "jasmine-core": "~5.1.2",
    "jasmine-spec-reporter": "~7.0.0",
    "karma": "^6.4.3",
    "karma-chrome-launcher": "~3.2.0",
    "karma-coverage": "^2.2.1",
    "karma-jasmine": "~5.1.0",
    "karma-jasmine-html-reporter": "^2.1.0",
    "ng-packagr": "^18.0.0",
    "socket.io": ">=4.7.5",
    "ts-node": "~10.9.2",
    "typescript": "5.4.5"
  }
}
