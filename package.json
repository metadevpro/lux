{
  "name": "lux-demo",
  "description": "Lux Library and documentation. User Interface components for Angular.",
  "license": "MIT",
  "version": "0.31.0",
  "author": {
    "name": "Metadev S.L.",
    "url": "https://metadev.pro"
  },
  "repository": {
    "type": "git",
    "url": "git@github.com:metadevpro/lux.git"
  },
  "bugs": {
    "url": "https://github.com/metadevpro/lux/issues"
  },
  "homepage": "https://github.com/metadevpro/lux",
  "keywords": [
    "lux",
    "metadev",
    "components",
    "user-interface",
    "angular",
    "typescript"
  ],
  "scripts": {
    "compodoc": "npx compodoc -p projects/lux/tsconfig.lib.json",
    "postinstall": "npx ng build lux --configuration production",
    "ng": "ng",
    "start": "ng serve",
    "start-heroku": "http-server -p $PORT dist/lux-demo/",
    "build-start": "npm run build:lux && ng serve",
    "build": "ng build --configuration production",
    "build:lux": "ng build lux --configuration production",
    "test": "jest",
    "test:watch": "ng test --watch",
    "test:coverage": "jest --coverage lux",
    "test:travis": "ng test lux --watch=false --code-coverage --browsers ChromeHeadlessCI",
    "tdd": "ng test lux",
    "lint": "ng lint",
    "lint:lux": "ng lint lux",
    "publish-doc": "cd scripts && ./publish-lux-doc-s3.sh",
    "npm-publish": "npm run lint:lux && npm run test:coverage && ng build lux --configuration production && npm publish ./dist/lux --access public"
  },
  "private": true,
  "dependencies": {
    "@angular/animations": "^20.0.6",
    "@angular/cli": "^20.0.5",
    "@angular/common": "^20.0.6",
    "@angular/compiler": "^20.0.6",
    "@angular/core": "^20.0.6",
    "@angular/forms": "^20.0.6",
    "@angular/platform-browser": "^20.0.6",
    "@angular/platform-browser-dynamic": "^20.0.6",
    "@angular/router": "^20.0.6",
    "http-server": "^14.1.1",
    "prismjs": "^1.29.0",
    "rxjs": "~7.8.2",
    "tslib": "^2.8.1",
    "zone.js": "^0.15.0"
  },
  "devDependencies": {
    "@angular-builders/jest": "^20.0.0",
    "@angular-devkit/build-angular": "20.0.4",
    "@angular-eslint/builder": "20.1.0",
    "@angular-eslint/eslint-plugin": "20.1.0",
    "@angular-eslint/eslint-plugin-template": "20.1.0",
    "@angular-eslint/schematics": "20.1.0",
    "@angular-eslint/template-parser": "20.1.0",
    "@angular/compiler-cli": "20.0.6",
    "@angular/language-service": "20.0.6",
    "@ngneat/spectator": "^19.4.2",
    "@types/jasmine": "~5.1.7",
    "@types/jasminewd2": "~2.0.13",
    "@types/jest": "^30.0.0",
    "@types/node": "^22.13.9",
    "@typescript-eslint/eslint-plugin": "8.26.0",
    "@typescript-eslint/parser": "8.26.0",
    "eslint": "^9.21.0",
    "eslint-plugin-import": "2.31.0",
    "eslint-plugin-jsdoc": "50.6.3",
    "jasmine-core": "~5.6.0",
    "jasmine-spec-reporter": "~7.0.0",
    "jest": "^29.7.0",
    "jest-preset-angular": "^14.6.0",
    "karma": "^6.4.4",
    "karma-chrome-launcher": "~3.2.0",
    "karma-coverage": "^2.2.1",
    "karma-jasmine": "~5.1.0",
    "karma-jasmine-html-reporter": "^2.1.0",
    "ng-packagr": "^20.0.1",
    "socket.io": ">=4.8.1",
    "ts-jest": "^29.4.0",
    "ts-node": "~10.9.2",
    "typescript": "5.8.2"
  }
}
