{
  "name": "lux-demo",
  "description": "Lux Library and documentation. User Interface components for Angular.",
  "license": "MIT",
  "version": "0.32.0",
  "author": {
    "name": "Metadev S.L.",
    "url": "https://metadev.pro"
  },
  "repository": {
    "type": "git",
    "url": "git@github.com:metadevpro/lux.git"
  },
  "bugs": {
    "url": "https://github.com/metadevpro/lux/issues"
  },
  "homepage": "https://github.com/metadevpro/lux",
  "keywords": [
    "lux",
    "metadev",
    "components",
    "user-interface",
    "angular",
    "typescript"
  ],
  "scripts": {
    "compodoc": "npx compodoc -p projects/lux/tsconfig.lib.json",
    "postinstall": "npx ng build lux --configuration production",
    "ng": "ng",
    "start": "ng serve",
    "start-heroku": "http-server -p $PORT dist/lux-demo/",
    "build-start": "npm run build:lux && ng serve",
    "build": "ng build --configuration production",
    "build:lux": "ng build lux --configuration production",
    "test": "jest",
    "test:watch": "ng test --watch",
    "test:coverage": "jest --coverage lux",
    "test:travis": "ng test lux --watch=false --code-coverage --browsers ChromeHeadlessCI",
    "tdd": "ng test lux",
    "lint": "ng lint",
    "lint:lux": "ng lint lux",
    "publish-doc": "cd scripts && ./publish-lux-doc-s3.sh",
    "npm-publish": "npm run lint:lux && npm run test:coverage && ng build lux --configuration production && npm publish ./dist/lux --access public"
  },
  "private": true,
  "dependencies": {
    "@angular/animations": "^21.0.2",
    "@angular/cli": "^21.0.1",
    "@angular/common": "^21.0.2",
    "@angular/compiler": "^21.0.2",
    "@angular/core": "^21.0.2",
    "@angular/forms": "^21.0.2",
    "@angular/platform-browser": "^21.0.2",
    "@angular/platform-browser-dynamic": "^21.0.2",
    "@angular/router": "^21.0.2",
    "http-server": "^14.1.1",
    "prismjs": "^1.29.0",
    "rxjs": "~7.8.2",
    "tslib": "^2.8.1",
    "zone.js": "^0.16.0"
  },
  "overrides": {
    "@angular-builders/jest": {
      "@angular-devkit/build-angular": "^21.0.1",
      "@angular/core": "^21.0.2",
      "@angular/compiler-cli": "^21.0.2",
      "@angular/platform-browser-dynamic": "^21.0.2"
    }
  },
  "devDependencies": {
    "@angular-builders/jest": "^20.0.0",
    "@angular-devkit/build-angular": "^21.0.1",
    "@angular-eslint/builder": "^21.0.1",
    "@angular-eslint/eslint-plugin": "^21.0.1",
    "@angular-eslint/eslint-plugin-template": "^21.0.1",
    "@angular-eslint/schematics": "^21.0.1",
    "@angular-eslint/template-parser": "^21.0.1",
    "@angular/compiler-cli": "^21.0.2",
    "@angular/language-service": "^21.0.2",
    "@ngneat/spectator": "^22.1.0",
    "@types/jasmine": "^5.1.13",
    "@types/jasminewd2": "~2.0.13",
    "@types/jest": "^30.0.0",
    "@types/node": "^24.10.1",
    "@typescript-eslint/eslint-plugin": "^8.48.1",
    "@typescript-eslint/parser": "^8.48.1",
    "eslint": "^9.39.1",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-jsdoc": "^61.4.1",
    "jasmine-core": "^5.13.0",
    "jasmine-spec-reporter": "~7.0.0",
    "jest": "^30.2.0",
    "jest-preset-angular": "^16.0.0",
    "karma": "^6.4.4",
    "karma-chrome-launcher": "~3.2.0",
    "karma-coverage": "^2.2.1",
    "karma-jasmine": "~5.1.0",
    "karma-jasmine-html-reporter": "^2.1.0",
    "ng-packagr": "^21.0.0",
    "socket.io": ">=4.8.1",
    "ts-jest": "^29.4.6",
    "ts-node": "~10.9.2",
    "typescript": "^5.9.3"
  }
}
